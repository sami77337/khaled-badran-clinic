# Dr. Khaled Badran Clinic environment template.
# Copy to .env for local use. Do not commit .env or real secrets.

# Django mode and secrets
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=true
DJANGO_PRODUCTION=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Locale
TIME_ZONE=Asia/Amman
LANGUAGE_CODE=ar

# Database
# Local development: leave DATABASE_URL empty to use db.sqlite3.
# Production: use PostgreSQL, for example:
# DATABASE_URL=postgres://clinic_user:replace-with-db-password@db-host.example.com:5432/khaled_badran_clinic
DATABASE_URL=
DATABASE_CONN_MAX_AGE=0
DATABASE_CONN_HEALTH_CHECKS=false
DATABASE_SSL_REQUIRE=false

# Cache and booking rate limiting
# Local development: leave CACHE_URL empty to use LocMemCache.
# Production: use a shared cache such as Redis:
# CACHE_URL=redis://redis-host.example.com:6379/1
CACHE_URL=
DJANGO_CACHE_KEY_PREFIX=kbc

# HTTPS and secure cookies
# Production should set these explicitly through config.settings.prod.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Reverse proxy handling
# Enable SECURE_PROXY_SSL_HEADER only when a trusted reverse proxy sets
# X-Forwarded-Proto=https for HTTPS requests.
DJANGO_SECURE_PROXY_SSL_HEADER_ENABLED=false
# Keep X-Forwarded-For untrusted unless the proxy strips client-supplied values.
BOOKING_TRUST_X_FORWARDED_FOR=false
BOOKING_TRUSTED_PROXY_CONFIGURED=false

# Logging and optional error reporting
DJANGO_LOG_LEVEL=INFO
SENTRY_DSN=

# Email placeholders for future production notifications.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=

# Storage
MEDIA_PRIVATE_ROOT=media_private

# Meta Cloud API: disabled until configured. Never commit operator values.
WHATSAPP_META_ENABLED=false
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_WABA_ID=
WHATSAPP_META_APP_SECRET=
WHATSAPP_META_VERIFY_TOKEN=
# Operator-selected supported Graph version, including the v prefix; no default.
WHATSAPP_META_GRAPH_VERSION=
# Names of templates approved in Meta; see docs/WHATSAPP_META_SETUP.md.
WHATSAPP_META_OTP_TEMPLATE=
WHATSAPP_META_CONSULTATION_REPLY_TEMPLATE=
WHATSAPP_META_BOOKING_CONFIRMATION_TEMPLATE=
WHATSAPP_META_APPOINTMENT_REMINDER_TEMPLATE=
WHATSAPP_META_LOCATION_TEMPLATE=
WHATSAPP_META_TEMPLATE_LANGUAGE_AR=ar
WHATSAPP_META_TEMPLATE_LANGUAGE_EN=en_US
WHATSAPP_HANDOFF_TTL_SECONDS=86400

# Existing callable contracts, implemented by the opt-in adapter.
# OTP sender signature: (phone_e164, code, language). False means failure.
GUEST_CONSULTATION_OTP_SENDER=apps.whatsapp.meta.send_guest_otp
# Optional account-specific callable; blank reuses GUEST_CONSULTATION_OTP_SENDER.
PATIENT_ACCOUNT_OTP_SENDER=
# Reply sender signature: (phone_e164, message, website_url, language).
WHATSAPP_CONSULTATION_NOTIFICATION_SENDER=apps.whatsapp.meta.send_consultation_notification
# Trusted HTTPS website origin for links; never derived from incoming Host headers.
WHATSAPP_WEBSITE_ORIGIN=
WHATSAPP_DEFAULT_LANGUAGE=ar

# Direct staff Web Push. Operator values only; never commit real VAPID keys.
WEB_PUSH_ENABLED=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=
